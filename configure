#!/bin/sh
set -eu

if test -z "${POD5_ROOT:-}"; then
  echo "Set POD5_ROOT to the native installation directory." >&2
  exit 1
fi

case "$POD5_ROOT" in
  /*) ;;
  *)
    echo "POD5_ROOT must be an absolute path." >&2
    exit 1
    ;;
esac

case "$POD5_ROOT" in
  *[!a-zA-Z0-9_./-]*)
    echo "POD5_ROOT must not contain spaces or shell metacharacters." >&2
    exit 1
    ;;
esac

test -f "$POD5_ROOT/include/pod5_format/c_api.h" || {
  echo "Cannot find the POD5 C API header." >&2
  exit 1
}

lib_dir="$POD5_ROOT/lib"

libs="$lib_dir/libpod5_format.a"
libs="$libs $lib_dir/libarrow.a"
libs="$libs $lib_dir/libzstd.a"
libs="$libs $lib_dir/libz.a"

for lib in $libs; do
  test -f "$lib" || {
    echo "Missing library: $lib" >&2
    exit 1
  }
done

cat > src/Makevars <<EOF
CXX_STD = CXX17
PKG_CPPFLAGS = -I$POD5_ROOT/include
PKG_LIBS = $libs -pthread -ldl -lrt -lm -Wl,--exclude-libs,ALL
EOF
